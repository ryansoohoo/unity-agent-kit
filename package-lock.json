{
  "name": "unity-agent-kit-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "unity-agent-kit-monorepo",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@unity-agent-kit/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/unity-agent-kit": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "unity-agent-kit",
      "version": "0.4.0",
      "license": "MIT",
      "dependencies": {
        "@unity-agent-kit/core": "0.4.0"
      },
      "bin": {
        "unity-agent-kit": "bin/kit.js"
      }
    },
    "packages/core": {
      "name": "@unity-agent-kit/core",
      "version": "0.4.0",
      "license": "MIT"
    }
  }
}
